# Copia este archivo a ".env.local" para desarrollo (opcional), o configura estas
# variables en Vercel (Project Settings -> Environment Variables) para produccion.
#
# Todas son de SERVIDOR: nunca se exponen al navegador.

# -- Acceso ------------------------------------------------------------------

# LA contrasena de la app. Valerio entra escribiendola y ya: no hay usuarios
# ni roles por ahora (el codigo los soporta -variable USUARIOS-, pero estan
# guardados para cuando hagan falta).
SITE_PASSWORD=

# (Opcional) Secreto para firmar la cookie de sesion. Si se deja vacio se usa
# SITE_PASSWORD. Cambiarlo cierra todas las sesiones sin tocar la contrasena.
SESSION_SECRET=

# -- El webhook del telefono (registro automatico) ---------------------------

# Token secreto del endpoint /api/inbox, al que MacroDroid reenvia los SMS del
# banco. Sin esta variable el webhook esta APAGADO. Invente uno largo:
#   node -e "console.log(crypto.randomUUID() + crypto.randomUUID())"
INBOX_TOKEN=

# -- Almacenamiento ----------------------------------------------------------
#
# Estas NO se escriben a mano: las inyecta Vercel al conectar los stores
# (Storage -> Upstash Redis, y Storage -> Blob) al proyecto. Hay que volver a
# desplegar para que el build las tome.
#
# En local no hacen falta: sin ellas los datos van a .data/store.json y los
# recibos a .data/adjuntos/.

# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# BLOB_READ_WRITE_TOKEN=

# Nota: en desarrollo local (npm run dev) el acceso es abierto, sin contrasena,
# y actuas como administrador.
